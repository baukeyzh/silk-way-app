# Кэш с абсолютными путями (НЕ должен быть в репозитории!)
/bootstrap/cache/config.php
/bootstrap/cache/routes-v7.php
/bootstrap/cache/routes.php
/storage/framework/views/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*

# Логи (могут быть большими)
/storage/logs/*.log

# База данных SQLite (чувствительные данные)
/database/database.sqlite

# .env файл (чувствительные данные)
.env
.env.backup
.env.production

# Временные файлы
*.tmp
*.temp
*.cache

# IDE
.DS_Store

# Internal infra docs (contain example phone numbers + internal hostnames)
/wa-api.md

# Obsidian knowledge-graph vault — local-only, regenerated by scripts/sync-obsidian-vault.sh
/vault

# Obsidian local IDE state (created when opening project root as a vault)
/.obsidian

